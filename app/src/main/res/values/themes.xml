<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        The look is taken from the beeper's e-ink screen: black ink on paper, bold text,
        outlined boxes and a row of three soft keys at the bottom.
        The colors change by themselves in dark mode (values-night/colors.xml).
    -->
    <style name="Base.Theme.EbeepMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:backgroundDimAmount">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/AppButton</item>
        <item name="textInputStyle">@style/AppTextInput</item>
        <item name="materialCardViewStyle">@style/AppCard</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="materialAlertDialogTheme">@style/AppDialog</item>
        <item name="switchStyle">@style/AppSwitch</item>
    </style>

    <style name="Theme.EbeepMobile" parent="Base.Theme.EbeepMobile">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Dialogs: rounded, with black buttons -->
    <style name="AppDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- The top bar of every screen (the beeper's header line) -->
    <style name="AppToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Ebeep.ToolbarTitle</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <!-- Text field: outlined box with a black line -->
    <style name="AppTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_small</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">@dimen/line_soft</item>
        <item name="boxStrokeWidthFocused">@dimen/line_strong</item>
        <item name="hintTextColor">@color/text_primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- Main action button: filled black ink -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/fill</item>
        <item name="android:textColor">@color/on_fill</item>
        <item name="cornerRadius">@dimen/corner_small</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Secondary action: black outline -->
    <style name="AppButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/line_strong</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/corner_small</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Dangerous action (delete account) -->
    <style name="AppButton.Danger" parent="AppButton.Outlined">
        <item name="strokeColor">@color/danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- On/off switches in the settings: clearly different on and off, in light and dark mode -->
    <style name="AppSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <!-- Soft keys: the three buttons at the bottom of a screen, like the beeper's three keys -->
    <style name="AppSoftKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/soft_key_text</item>
        <item name="iconTint">@color/soft_key_text</item>
        <item name="backgroundTint">@color/soft_key_background</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/soft_key_height</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Box with a strong black outline: menu tiles and the selected game -->
    <style name="AppTile" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/line_strong</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Quiet box with a soft outline: list rows and info boxes -->
    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/line_soft</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.Ebeep.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ebeep.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ebeep.Heading" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ebeep.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Big message text, like the message screen on the beeper -->
    <style name="TextAppearance.Ebeep.Message" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Ebeep.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>
