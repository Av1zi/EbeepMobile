<?xml version="1.0" encoding="utf-8"?>
<!-- Hosts the Register and Login fragments (screens 2 and 3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Purple header with the two tabs -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Register tab (right side in RTL) -->
            <LinearLayout
                android:id="@+id/tabRegister"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTabRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/tab_register"
                    android:textColor="@color/tab_active"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underlineRegister"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/tab_active" />
            </LinearLayout>

            <!-- Login tab (left side in RTL) -->
            <LinearLayout
                android:id="@+id/tabLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTabLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="@string/tab_login"
                    android:textColor="@color/tab_active"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underlineLogin"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/tab_active" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Swiping left and right moves between the Register and the Login fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
