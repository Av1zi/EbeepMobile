<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_screen">

            <!-- The last message, like the message screen on the beeper -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_last_message"
                android:textAppearance="@style/TextAppearance.Ebeep.Heading" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_strong"
                android:layout_marginTop="@dimen/space_small"
                android:background="@color/outline" />

            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Ebeep.Message" />

            <TextView
                android:id="@+id/txtMessageInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Ebeep.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_section"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileChat"
                    style="@style/AppTile"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- An ImageView, not a compound drawable, so the icon can be bigger -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_inbox" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_small"
                            android:text="@string/home_chat"
                            android:textAppearance="@style/TextAppearance.Ebeep.Heading" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileGames"
                    style="@style/AppTile"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="@dimen/space_item"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- An ImageView, not a compound drawable, so the icon can be bigger -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_games" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_small"
                            android:text="@string/home_games"
                            android:textAppearance="@style/TextAppearance.Ebeep.Heading" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileHistory"
                    style="@style/AppTile"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="@dimen/space_item"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- An ImageView, not a compound drawable, so the icon can be bigger -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="@dimen/tile_icon"
                            android:layout_height="@dimen/tile_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_history" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_small"
                            android:text="@string/home_history"
                            android:textAppearance="@style/TextAppearance.Ebeep.Heading" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
