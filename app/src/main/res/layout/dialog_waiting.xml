<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_screen"
    android:paddingTop="@dimen/space_item"
    android:paddingEnd="@dimen/space_screen"
    android:paddingBottom="@dimen/space_item">

    <ProgressBar
        android:layout_width="36dp"
        android:layout_height="36dp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_item"
        android:layout_weight="1"
        android:text="@string/games_waiting_text"
        android:textAppearance="@style/TextAppearance.Ebeep.Body" />
</LinearLayout>
