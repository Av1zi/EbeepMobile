package com.ebeep.mobile;

/**
 * Private values that must not be committed to GitHub (this file is in .gitignore).
 * Copy Secrets.java.example to this file and fill in the real values.
 */
public final class Secrets {

    // Same broker as the beeper's secret.h (MQTT over TLS)
    public static final String BROKER_URL = "ssl://YOUR_BROKER_HOST:8883";

    // From console.anthropic.com
    public static final String CLAUDE_API_KEY = "YOUR_CLAUDE_API_KEY";

    private Secrets() {
    }
}
