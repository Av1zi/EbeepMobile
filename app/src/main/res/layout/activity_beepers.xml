<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listBeepers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_screen" />

        <!-- Shown instead of the list when there are no beepers -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_screen"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/AppTile"
                android:layout_width="96dp"
                android:layout_height="96dp">

                <ImageView
                    android:layout_width="@dimen/tile_icon"
                    android:layout_height="@dimen/tile_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_inbox" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_item"
                android:text="@string/beepers_empty_title"
                android:textAppearance="@style/TextAppearance.Ebeep.Heading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:gravity="center"
                android:text="@string/beepers_empty"
                android:textAppearance="@style/TextAppearance.Ebeep.Caption" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/view_soft_keys" />
</LinearLayout>
