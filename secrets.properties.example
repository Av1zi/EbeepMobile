# Private values. Copy this file to secrets.properties (which is in .gitignore) and fill it in.

# The MQTT broker from the beeper's secret.h (host name only, no "ssl://" and no port)
BROKER_HOST=YOUR_BROKER_HOST
BROKER_PORT=8883

# Your own key from ai.kavyansh.org (for the AI reply suggestion)
GOOGLE_API_KEY=YOUR_GATEWAY_KEY
